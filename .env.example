# ============================================
# MONTEX ERP V5 - Variáveis de Ambiente
# ============================================
# COPIE este arquivo para .env e preencha os valores
# NUNCA commite o arquivo .env no git!
# ============================================

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui
# ATENÇÃO: a service_role key NUNCA deve existir no cliente (tudo com prefixo
# VITE_ vai para o bundle público). Operações administrativas usam Edge
# Functions (admin-users, send-push, notify-pending) com o secret no Supabase.

# Monitoramento de erros (Sentry). Opcional: sem DSN o Sentry fica desligado.
# Release = VERCEL_GIT_COMMIT_SHA (automático no Vercel).
VITE_SENTRY_DSN=
